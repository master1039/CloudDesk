# Runtime
DEMO_MODE=true
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# Authentication — placeholders only; replace outside demo environments
JWT_SECRET=replace-with-a-random-secret
SUPABASE_JWT_SECRET=

# Persistence
DATABASE_URL=sqlite+aiosqlite:///./data/support.db
CHECKPOINT_DB_PATH=./data/checkpoints.db

# Cache and short-term memory (empty REDIS_URL selects fakeredis)
REDIS_URL=
USE_FAKE_REDIS=true

# Language model (fake runs fully offline)
LLM_PROVIDER=fake
LLM_API_KEY=
LLM_MODEL=fake

# Embeddings
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=fake-embedding
EMBEDDING_DIMENSIONS=384

# Vector store
VECTOR_STORE=memory
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=clouddesk_knowledge

# Tool and request policy
APPROVAL_REQUIRED_FOR_REFUNDS=true
MAX_REFUND_WITHOUT_APPROVAL=0
TOOL_TIMEOUT_SECONDS=30
RATE_LIMIT_PER_MINUTE=120
SAMPLE_DATA_DIR=./sample_data

# Optional LangSmith tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=clouddesk-support
